APP_NAME="GeniusCorp API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://geniuscorp-api.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ในเครื่องและบน VPS ใช้ MySQL ตามคอร์ส
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=geniuscorp
DB_USERNAME=root
DB_PASSWORD=

# บน Render (แผนฟรี) สลับเป็น SQLite เพราะไม่มี MySQL ให้ใช้ และไฟล์จะถูกสร้างใหม่ทุกครั้งที่ deploy
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite
# SEED_ON_BOOT=true
# BUILD_TOKEN=            # ค่าเดียวกับ API_TOKEN ฝั่ง Astro (openssl rand -hex 24)

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

COMPANY_NAME="GeniusCorp Co., Ltd."
COMPANY_SITE_URL=https://www.geniuscorp.example

# Day 4: Rebuild อัตโนมัติเมื่อเนื้อหาเปลี่ยน (ต้องมี queue worker: php artisan queue:work)
# บน Render แผนฟรีไม่มี Background Worker ให้ตั้ง QUEUE_CONNECTION=sync (job จะทำงานทันทีในคำขอนั้น)
REBUILD_ENABLED=false
REBUILD_DRIVER=webhook            # webhook | github
REBUILD_WEBHOOK_URL=https://build.geniuscorp.example/rebuild
REBUILD_WEBHOOK_SECRET=change-me
REBUILD_GITHUB_REPO=geniuscorp/geniuscorp-web
REBUILD_GITHUB_TOKEN=
